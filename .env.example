# FarmAgent Environment Configuration
# Optional: External API keys. If not provided, FarmAgent runs seamlessly in 100% offline Mock/Simulation mode!

# Web Server Port
PORT=5000

# Groq API Configuration (Fast LLaMA 3.3 / LLaMA 3.1 Inference)
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional OpenWeatherMap API Key for live weather metrics
# Leave blank to use built-in agrometeorological mock presets
OPENWEATHER_API_KEY=
